{
  "name": "TokenomicsPlan",
  "type": "object",
  "properties": {
    "planName": {
      "type": "string",
      "description": "Name of the tokenomics plan"
    },
    "tokenSymbol": {
      "type": "string",
      "description": "Token symbol (e.g. ZHS)"
    },
    "totalSupply": {
      "type": "number",
      "description": "Total token supply"
    },
    "allocations": {
      "type": "string",
      "description": "JSON stringified allocation groups (percent per group)"
    },
    "lockSchedule": {
      "type": "string",
      "description": "JSON stringified Streamflow lock/vesting schedule per group"
    },
    "burnBuyback": {
      "type": "string",
      "description": "JSON stringified burn & buyback program configuration"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "Whether plan is active"
    }
  },
  "required": [
    "planName",
    "tokenSymbol",
    "totalSupply"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}