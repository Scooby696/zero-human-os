{
  "name": "WorkspaceTeamMember",
  "type": "object",
  "properties": {
    "workspaceId": {
      "type": "string",
      "description": "ID of workspace"
    },
    "userId": {
      "type": "string",
      "description": "ID of user"
    },
    "email": {
      "type": "string",
      "description": "Email of team member"
    },
    "role": {
      "type": "string",
      "enum": [
        "viewer",
        "editor",
        "admin"
      ],
      "description": "Member role in workspace"
    }
  },
  "required": [
    "workspaceId",
    "userId",
    "role"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}